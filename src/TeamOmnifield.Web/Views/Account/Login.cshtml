@model LoginViewModel
@{
    var returnUrl = (string?)Context.Request.Query["returnUrl"] ?? string.Empty;
    var developer = returnUrl.StartsWith("/Platform", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = developer ? "Developer Login" : "Admin Login";
}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-badge">
            @if (developer)
            {
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 2 4 5v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V5l-8-3Z" />
                    <circle cx="12" cy="9.6" r="2.4" />
                    <path d="M8.2 15.8c.8-1.8 2.1-2.7 3.8-2.7s3 .9 3.8 2.7" />
                </svg>
            }
            else
            {
                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 2 4 5v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V5l-8-3Z" />
                    <rect x="9.4" y="10.6" width="5.2" height="4.4" rx="0.6" />
                    <path d="M10.4 10.6V9a1.6 1.6 0 0 1 3.2 0v1.6" />
                </svg>
            }
        </div>
        <h1 class="auth-title headline">Login</h1>
        <p class="auth-subtitle text-muted">Please sign in to access your dashboard</p>

        <div asp-validation-summary="ModelOnly" class="alert-error" style="margin-top:20px"></div>

        <form asp-action="Login" method="post" class="auth-form">
            <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />
            <div class="auth-field">
                <label asp-for="Email"></label>
                <div class="auth-input">
                    <svg class="icon-left" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
                    <input asp-for="Email" placeholder="Enter your email address" autocomplete="username" />
                </div>
                <span asp-validation-for="Email" class="field-error-text"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Password"></label>
                <div class="auth-input has-toggle">
                    <svg class="icon-left" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                    <input asp-for="Password" placeholder="Enter your password" autocomplete="current-password" data-password-input />
                    <button type="button" class="icon-toggle" data-toggle-password aria-label="Show password">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 12S5 5 12 5s10.5 7 10.5 7-3.5 7-10.5 7S1.5 12 1.5 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-error-text"></span>
            </div>
            <button class="btn auth-submit" type="submit">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><path d="M10 17l5-5-5-5" /><path d="M15 12H3" /></svg>
                Sign in
            </button>
        </form>

        <div class="auth-footer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V5l-8-3Z" /></svg>
            Secure Access
        </div>
    </div>
</div>
