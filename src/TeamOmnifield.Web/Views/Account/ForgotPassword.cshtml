@model ResetPasswordViewModel
@{
    var returnUrl = (string?)Context.Request.Query["returnUrl"] ?? string.Empty;
    var developer = returnUrl.StartsWith("/Platform", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = developer ? "Reset Developer Password" : "Reset Admin Password";
    var loginUrl = "/Account/Login" + (string.IsNullOrEmpty(returnUrl) ? "" : "?returnUrl=" + Uri.EscapeDataString(returnUrl));
}
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-badge">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2 4 5v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V5l-8-3Z" />
                <path d="M9 12l2 2 4-4" />
            </svg>
        </div>
        <h1 class="auth-title headline">Reset password</h1>
        <p class="auth-subtitle text-muted">Choose a new password for your @(developer ? "developer" : "admin") account</p>

        <div asp-validation-summary="All" class="alert-error" style="margin-top:20px"></div>

        <form asp-action="ForgotPassword" method="post" class="auth-form">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="auth-field">
                <label asp-for="Email">Username (email)</label>
                <div class="auth-input">
                    <svg class="icon-left" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
                    <input asp-for="Email" placeholder="Enter your username" autocomplete="username" />
                </div>
            </div>
            <div class="auth-field">
                <label asp-for="NewPassword">New password</label>
                <div class="auth-input has-toggle">
                    <svg class="icon-left" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                    <input asp-for="NewPassword" placeholder="At least 8 characters, 1 special" autocomplete="new-password" data-password-input />
                    <button type="button" class="icon-toggle" data-toggle-password aria-label="Show password">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 12S5 5 12 5s10.5 7 10.5 7-3.5 7-10.5 7S1.5 12 1.5 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                    </button>
                </div>
            </div>
            <div class="auth-field">
                <label asp-for="ConfirmPassword">Confirm new password</label>
                <div class="auth-input">
                    <svg class="icon-left" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                    <input asp-for="ConfirmPassword" placeholder="Re-enter the new password" autocomplete="new-password" />
                </div>
            </div>
            <button class="btn auth-submit" type="submit">Update password</button>
        </form>

        <p class="auth-forgot" style="text-align:center;margin:20px 0 0"><a href="@loginUrl">&larr; Back to sign in</a></p>
    </div>
</div>
