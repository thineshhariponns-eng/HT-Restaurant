@inject TeamOmnifield.Web.Services.CityContextService CityContext
@{
    // Customer pages get the storefront theme; the admin login (Account) and the TeamOmnifield page keep the original look.
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var bodyClass = ViewData["BodyClass"] as string ?? (controller is "Account" or "Team" ? "" : "customer");

    // Header/footer follow whichever city the visitor picked from the Locations pop-up (see HomeController.CityStorefront).
    // ViewBag.City wins when this very request just chose one (the cookie isn't visible until the next request);
    // otherwise fall back to the cookie, and to the default HQ branding until a city has ever been picked.
    var city = ViewBag.City as CityInfo ?? CityContext.Current;
    var description = ViewData["Description"] as string
        ?? $"HT Restaurant {city.Name} — order home-style Indian cooking for pickup, delivery or dine-in.";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - HT Restaurant @city.Name</title>
    <meta name="description" content="@description" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (bodyClass.Contains("customer"))
    {
        <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@bodyClass">
<header class="site-header">
    <div class="container bar">
        <a href="/chennai" class="brand-mark">
            <span class="name">HT Restaurant</span>
            <span class="place">@city.Name</span>
        </a>
        <nav class="primary-nav" aria-label="Primary">
            <a href="/chennai">Home</a>
            <a href="/Menu">Menu</a>
            <a href="/Orders">My Orders</a>
            <a href="/Cart">Cart</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/Admin">Admin</a>
            }
        </nav>
        <div class="header-actions">
            <a href="/Cart" class="cart-btn" aria-label="View cart">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1" /><circle cx="18" cy="20" r="1" /><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6" /></svg>
                <span class="hint" style="display:none" data-cart-label>Cart</span>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline"><button class="btn btn-ghost" type="submit">Logout</button></form>
            }
            else
            {
                <a href="/Account/Login" class="btn btn-secondary btn-sm">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg>
                    Login
                </a>
            }
            <button type="button" class="nav-toggle" data-nav-toggle="#mobileNav" aria-expanded="false" aria-controls="mobileNav" aria-label="Toggle menu">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>
        </div>
    </div>
    <nav id="mobileNav" class="mobile-nav" aria-label="Primary mobile">
        <a href="/chennai">Home</a>
        <a href="/Menu">Menu</a>
        <a href="/Orders">My Orders</a>
        <a href="/Cart">Cart</a>
        @if (User.Identity?.IsAuthenticated == true) { <a href="/Admin">Admin</a> }
        else
        {
            <a href="/Account/Login" class="auth-link" hidden>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg>
                Login
            </a>
        }
    </nav>
</header>
<main>
    <div class="container" style="padding-top:18px">
        @if (TempData["Error"] is string error) { <div class="alert-error">@error</div> }
    </div>
    @RenderBody()
</main>
<footer class="site-footer">
    <div class="container grid">
        <div>
            <p class="brand-mark"><span class="name">HT Restaurant</span><span class="place">@city.Name</span></p>
            <p class="text-muted" style="margin-top:12px;max-width:280px;font-size:0.875rem">Contemporary Indian kitchen serving @city.Name's home-style flavors and turmeric-country produce, plated with a modern touch.</p>
        </div>
        <nav aria-label="Footer">
            <h2>Explore</h2>
            <ul>
                <li><a href="/chennai">Home</a></li>
                <li><a href="/Menu">Menu</a></li>
                <li><a href="/Orders">My Orders</a></li>
                <li><a href="/Cart">Cart</a></li>
            </ul>
        </nav>
        <div>
            <h2>Contact</h2>
            <ul>
                <li>@city.AddressLine1<br />@city.AddressLine2</li>
                <li><a href="tel:+919876543210">+91 98765 43210</a></li>
                <li><a href="mailto:@city.Email">@city.Email</a></li>
            </ul>
        </div>
        <div>
            <h2>Hours</h2>
            <ul>
                <li>Mon&ndash;Fri <span class="text-muted tabular">11:00 AM &ndash; 10:30 PM</span></li>
                <li>Sat&ndash;Sun <span class="text-muted tabular">10:30 AM &ndash; 11:00 PM</span></li>
            </ul>
        </div>
    </div>
    <div class="bottom"><div class="container">&copy; @DateTime.Now.Year HT Restaurant @city.Name &middot; Powered by TeamOmnifield</div></div>
</footer>
@await RenderSectionAsync("Scripts", required: false)
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
