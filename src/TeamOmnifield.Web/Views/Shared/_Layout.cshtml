<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - HT Restaurant Erode</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <div class="container bar">
        <a href="/" class="brand-mark">
            <span class="name">HT Restaurant</span>
            <span class="place">Erode</span>
        </a>
        <nav class="primary-nav" aria-label="Primary">
            <a href="/">Home</a>
            <a href="/Menu">Menu</a>
            <a href="/Cart">Cart</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/Admin">Admin</a>
            }
        </nav>
        <div class="header-actions">
            <a href="/Cart" class="cart-btn" aria-label="View cart">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1" /><circle cx="18" cy="20" r="1" /><path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6" /></svg>
                <span class="hint" style="display:none" data-cart-label>Cart</span>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline"><button class="btn btn-ghost" type="submit">Logout</button></form>
            }
            else
            {
                <a href="/Account/Login" class="btn btn-secondary btn-sm">Admin Login</a>
            }
            <button type="button" class="nav-toggle" data-nav-toggle="#mobileNav" aria-expanded="false" aria-controls="mobileNav" aria-label="Toggle menu">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>
        </div>
    </div>
    <nav id="mobileNav" class="mobile-nav" aria-label="Primary mobile">
        <a href="/">Home</a>
        <a href="/Menu">Menu</a>
        <a href="/Cart">Cart</a>
        @if (User.Identity?.IsAuthenticated == true) { <a href="/Admin">Admin</a> }
    </nav>
</header>
<main>
    <div class="container" style="padding-top:18px">
        @if (TempData["Error"] is string error) { <div class="alert-error">@error</div> }
    </div>
    @RenderBody()
</main>
<footer class="site-footer">
    <div class="container grid">
        <div>
            <p class="brand-mark"><span class="name">HT Restaurant</span><span class="place">Erode</span></p>
            <p class="text-muted" style="margin-top:12px;max-width:280px;font-size:0.875rem">Contemporary Indian kitchen serving Erode's home-style flavors and turmeric-country produce, plated with a modern touch.</p>
        </div>
        <nav aria-label="Footer">
            <h2>Explore</h2>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/Menu">Menu</a></li>
                <li><a href="/Cart">Cart</a></li>
            </ul>
        </nav>
        <div>
            <h2>Contact</h2>
            <ul>
                <li>142, Perundurai Road,<br />Erode, Tamil Nadu 638011</li>
                <li><a href="tel:+919876543210">+91 98765 43210</a></li>
                <li><a href="mailto:hello@htrestauranterode.in">hello@htrestauranterode.in</a></li>
            </ul>
        </div>
        <div>
            <h2>Hours</h2>
            <ul>
                <li>Mon&ndash;Fri <span class="text-muted tabular">11:00 AM &ndash; 10:30 PM</span></li>
                <li>Sat&ndash;Sun <span class="text-muted tabular">10:30 AM &ndash; 11:00 PM</span></li>
            </ul>
        </div>
    </div>
    <div class="bottom"><div class="container">&copy; @DateTime.Now.Year HT Restaurant Erode &middot; Powered by TeamOmnifield</div></div>
</footer>
@await RenderSectionAsync("Scripts", required: false)
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
