@model CustomerRegisterViewModel
@{
    Layout = "_CustomerAuthLayout";
    ViewData["Title"] = "Create Account";
    var returnUrl = ViewBag.ReturnUrl as string;
    var loginUrl = "/Customer/Login" + (string.IsNullOrEmpty(returnUrl) ? "" : "?returnUrl=" + Uri.EscapeDataString(returnUrl));
}
<div class="ca-form-wrap">
    <h1 class="ca-title">Create Account</h1>
    <p class="ca-sub">Join HT Restaurant and enjoy great food!</p>

    <div asp-validation-summary="ModelOnly" class="ca-alert"></div>

    <form asp-action="Register" method="post" novalidate>
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <div class="ca-field">
            <label asp-for="FullName">Full Name</label>
            <div class="ca-input">
                <svg class="ca-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg>
                <input asp-for="FullName" placeholder="Enter your full name" autocomplete="name" />
            </div>
            <span asp-validation-for="FullName" class="ca-error"></span>
        </div>
        <div class="ca-field">
            <label asp-for="Email">Email Address</label>
            <div class="ca-input">
                <svg class="ca-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
                <input asp-for="Email" placeholder="Enter your email address" autocomplete="username" />
            </div>
            <span asp-validation-for="Email" class="ca-error"></span>
        </div>
        <div class="ca-field">
            <label asp-for="Phone">Phone Number</label>
            <div class="ca-input">
                <svg class="ca-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" /></svg>
                <input asp-for="Phone" placeholder="Enter your phone number" inputmode="numeric" maxlength="10" autocomplete="tel" />
            </div>
            <span asp-validation-for="Phone" class="ca-error"></span>
        </div>
        <div class="ca-field">
            <label asp-for="Password">Password</label>
            <div class="ca-input has-toggle">
                <svg class="ca-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                <input asp-for="Password" placeholder="Create a password" autocomplete="new-password" />
                <button type="button" class="ca-toggle" data-toggle-password aria-label="Show password">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 12S5 5 12 5s10.5 7 10.5 7-3.5 7-10.5 7S1.5 12 1.5 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="ca-error"></span>
        </div>
        <div class="ca-field">
            <label asp-for="ConfirmPassword">Confirm Password</label>
            <div class="ca-input has-toggle">
                <svg class="ca-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                <input asp-for="ConfirmPassword" placeholder="Confirm your password" autocomplete="new-password" />
                <button type="button" class="ca-toggle" data-toggle-password aria-label="Show password">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 12S5 5 12 5s10.5 7 10.5 7-3.5 7-10.5 7S1.5 12 1.5 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="ca-error"></span>
        </div>
        <button class="ca-btn ca-btn-solid" type="submit">Create Account</button>
    </form>

    <p class="ca-note">Already have an account? <a href="@loginUrl">Login</a></p>
</div>
