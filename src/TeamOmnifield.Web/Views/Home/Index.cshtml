@model object
@{
    var city = (CityInfo)ViewBag.City;
    ViewData["Title"] = $"HT Restaurant {city.Name}";
    ViewData["BodyClass"] = "customer landing";
    var featured = ((IEnumerable<Product>)ViewBag.Featured).ToList();
    var heroImage = featured.FirstOrDefault(x => !string.IsNullOrWhiteSpace(x.ImageUrl));
    var companions = featured.Skip(1).Where(x => !string.IsNullOrWhiteSpace(x.ImageUrl)).Take(2).ToList();
}
@section Head {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <script>
        (function () {
            var d = document.documentElement;
            d.classList.add('js');
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            d.classList.add('js-motion');
            setTimeout(function () { if (!window.__lpMotion) d.classList.remove('js-motion'); }, 3000);
        })();
    </script>
}

<section class="lp-hero">
    @if (heroImage is not null)
    {
        <img class="lp-hero__img" src="@heroImage.ImageUrl" alt="" fetchpriority="high" />
    }
    <div class="lp-hero__glow" aria-hidden="true"></div>
    <div class="lp-wrap lp-hero__wrap">
        <div class="lp-hero__grid">
            <div class="lp-hero__copy">
                <p class="lp-crumb" data-hero><span class="dot"></span>Open now &middot; Closes 10:30 PM</p>
                <h1 data-split>HT Restaurant<br /><span>@city.Name</span></h1>
                <p class="lp-hero__lede" data-hero>Today's kitchen card, straight from @city.Street &mdash; order for pickup, delivery or dine-in.</p>
                <div class="lp-hero__cta" data-hero>
                    <a href="/Menu" class="lp-btn lp-btn--solid">Order now</a>
                    <a href="/Menu" class="lp-btn lp-btn--line">Explore menu</a>
                </div>
                <dl class="lp-facts" data-hero>
                    <div>
                        <dt>Location</dt><dd>@city.Address</dd>
                 </div>
                    <div><dt>Today's hours</dt><dd class="tabular">11:00 AM &ndash; 10:30 PM</dd></div>
                </dl>
            </div>
            @if (featured.Count > 0)
            {
                <aside class="lp-ticket" aria-label="Today's card" data-hero data-ticket>
                    <div class="lp-ticket__paper">
                        <p class="lp-ticket__head"><span>Today's card</span><span>@DateTime.Now.ToString("ddd d MMM")</span></p>
                        <ol class="lp-ticket__list">
                            @foreach (Product product in featured)
                            {
                                <li><span>@product.Name</span><i aria-hidden="true"></i><span class="tabular">₹@product.Price.ToString("0")</span></li>
                            }
                        </ol>
                        <a href="/Menu" class="lp-link">Start your order <span aria-hidden="true">&rarr;</span></a>
                    </div>
                </aside>
            }
        </div>
    </div>
</section>

@if (featured.Count > 0)
{
    <div class="lp-marquee" aria-hidden="true" data-marquee>
        <div class="lp-marquee__track" data-marquee-track>
            @for (var copy = 0; copy < 2; copy++)
            {
                <div class="lp-marquee__group">
                    @for (var repeat = 0; repeat < 2; repeat++)
                    {
                        foreach (Product product in featured)
                        {
                            <span class="lp-marquee__item">@product.Name</span>
                        }
                    }
                </div>
            }
        </div>
    </div>
}

<section class="lp-paper lp-menu" id="todays-menu">
    <div class="lp-wrap">
        <div class="lp-menu__head">
            <h2 class="lp-h2" data-split>Today's kitchen,<br />ready to order</h2>
            <div>
                <p data-reveal>@featured.Count dishes from today's card, prepared fresh to order. Add what you like, or open the full menu to see every dish.</p>
                <a href="/Menu" class="lp-link" data-reveal>Browse full menu <span aria-hidden="true">&rarr;</span></a>
            </div>
        </div>

        @if (featured.Count > 0)
        {
            <div class="lp-carousel" data-carousel>
                <ul class="lp-track" data-carousel-track>
                    @foreach (Product product in featured)
                    {
                        <li class="lp-dish">
                            <div class="lp-dish__photo">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                                }
                                else
                                {
                                    <span>Photo coming soon</span>
                                }
                            </div>
                            <div class="lp-dish__row">
                                <h3 class="lp-dish__name">@product.Name</h3>
                                <span class="lp-dish__price">₹@product.Price.ToString("0")</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(product.Description))
                            {
                                <p class="lp-dish__desc">@product.Description</p>
                            }
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="lp-btn lp-btn--ink lp-btn--block" aria-label="Add @product.Name to cart">Add to cart</button>
                            </form>
                        </li>
                    }
                </ul>
                <div class="lp-carousel__ctl">
                    <span data-carousel-count aria-live="polite">01 / @featured.Count.ToString("00")</span>
                    <button type="button" data-carousel-prev aria-label="Previous dishes">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
                    </button>
                    <button type="button" data-carousel-next aria-label="Next dishes">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                    </button>
                </div>
            </div>
        }
    </div>
</section>

<section class="lp-ways" aria-labelledby="ways-title">
    <div class="lp-wrap">
        <div class="lp-ways__head">
            <h2 class="lp-h2" id="ways-title" data-split>Pickup, delivery or dine-in &mdash; one kitchen</h2>
            <p data-reveal>Every dish is prepared fresh to order, whichever way it reaches you.</p>
        </div>
        <ol class="lp-steps">
            <li class="lp-step">
                <div class="lp-step__body" data-reveal>
                    <h3>Pickup</h3>
                    <p>Pickup ready in 20 minutes. Order ahead, walk in, and collect from @city.Street.</p>
                    <a href="/Menu" class="lp-link">Order for pickup <span aria-hidden="true">&rarr;</span></a>
                </div>
                <span class="lp-step__no" aria-hidden="true">01</span>
            </li>
            <li class="lp-step">
                <div class="lp-step__body" data-reveal>
                    <h3>Delivery</h3>
                    <p>Delivery within 5 km of @city.Street, brought to your door while it is hot.</p>
                    <a href="/Menu" class="lp-link">Order for delivery <span aria-hidden="true">&rarr;</span></a>
                </div>
                <span class="lp-step__no" aria-hidden="true">02</span>
            </li>
            <li class="lp-step">
                <div class="lp-step__body" data-reveal>
                    <h3>Dine-in</h3>
                    <p>Join us at @city.Address for the full card, served the way our kitchen intends.</p>
                    <a href="/Menu" class="lp-link">See the menu <span aria-hidden="true">&rarr;</span></a>
                </div>
                <span class="lp-step__no" aria-hidden="true">03</span>
            </li>
        </ol>
    </div>
</section>

<section class="lp-paper lp-story">
    <div class="lp-wrap lp-story__grid">
        <div class="lp-story__copy">
            <h2 class="lp-h2" data-split>About HT Restaurant @city.Name</h2>
            <p data-reveal>HT Restaurant has been serving @city.Name with a menu built around home-style Indian cooking and local produce. Our kitchen blends traditional recipes with a modern, considered plate &mdash; for dine-in, pickup and delivery alike.</p>
            <p data-reveal>Every dish is prepared fresh to order, using recipes developed by our kitchen team and ingredients sourced close to home.</p>
            <a href="/Menu" class="lp-link" data-reveal>View the menu <span aria-hidden="true">&rarr;</span></a>
        </div>
        @if (companions.Count > 0)
        {
            <div class="lp-frame @(companions.Count == 1 ? "lp-frame--single" : "")">
                @foreach (Product product in companions)
                {
                    <figure>
                        <div class="lp-frame__img"><img src="@product.ImageUrl" alt="@product.Name" loading="lazy" /></div>
                        <figcaption>@product.Name</figcaption>
                    </figure>
                }
            </div>
        }
    </div>
</section>

<section class="lp-faq" aria-labelledby="faq-title">
    <div class="lp-wrap">
        <h2 class="lp-h2" id="faq-title" data-split>Good to know</h2>
        <div class="lp-faq__list" data-reveal>
            <details>
                <summary>How do I place an order?</summary>
                <p>Open the <a href="/Menu">menu</a>, add the dishes you want to your cart and check out. Every dish is prepared fresh to order.</p>
            </details>
            <details>
                <summary>How long does pickup or delivery take?</summary>
                <p>Pickup is ready in 20 minutes. We deliver within 5 km of @city.Street.</p>
            </details>
            <details>
                <summary>Where are you and when are you open?</summary>
                <p>@city.Address. Monday to Friday 11:00 AM &ndash; 10:30 PM, Saturday and Sunday 10:30 AM &ndash; 11:00 PM.</p>
            </details>
            <details>
                <summary>How do I check on an order I placed?</summary>
                <p>Open <a href="/Orders">My Orders</a> and enter the phone number you ordered with.</p>
            </details>
            <details>
                <summary>How can I reach the restaurant?</summary>
                <p>Call <a href="tel:+919876543210">+91 98765 43210</a> or email <a href="mailto:@city.Email">@city.Email</a>.</p>
            </details>
        </div>
        <div class="lp-cta">
            <h2 data-split>The full card is ready <span>whenever you are.</span></h2>
            <a href="/Menu" class="lp-btn lp-btn--solid" data-reveal>View full menu</a>
        </div>
    </div>
</section>

@section Scripts {
<script src="~/lib/gsap.min.js" asp-append-version="true"></script>
<script src="~/lib/ScrollTrigger.min.js" asp-append-version="true"></script>
<script src="~/lib/lenis.min.js" asp-append-version="true"></script>
<script>
(function () {
  var root = document.querySelector('[data-carousel]');
  if (!root) return;
  var track = root.querySelector('[data-carousel-track]');
  var prev = root.querySelector('[data-carousel-prev]');
  var next = root.querySelector('[data-carousel-next]');
  var count = root.querySelector('[data-carousel-count]');
  var cards = track.children;
  var total = cards.length;

  function pad(n) { return n < 10 ? '0' + n : String(n); }
  function step() {
    return cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth;
  }
  function update() {
    var max = track.scrollWidth - track.clientWidth - 1;
    var index = Math.min(total, Math.round(track.scrollLeft / step()) + 1);
    if (track.scrollLeft >= max) index = total;
    count.textContent = pad(index) + ' / ' + pad(total);
    prev.disabled = track.scrollLeft <= 0;
    next.disabled = track.scrollLeft >= max;
  }
  prev.addEventListener('click', function () { track.scrollBy({ left: -step() }); });
  next.addEventListener('click', function () { track.scrollBy({ left: step() }); });
  track.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });
  window.addEventListener('resize', update);
  update();
})();
</script>
<script src="~/js/landing.js" asp-append-version="true"></script>
}
