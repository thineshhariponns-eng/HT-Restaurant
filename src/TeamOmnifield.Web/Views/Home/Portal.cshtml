@{
    // Brand welcome page, served at "/". Uses the brand shell (_PortalLayout), not the storefront _Layout,
    // because the ordering storefront lives at /chennai.
    Layout = "_PortalLayout";
    ViewData["Title"] = "HT Restaurant | Where Indian cuisine meets tradition";
    ViewData["Description"] = "HT Restaurant serves home-style Indian cooking, from slow-cooked biryani to crisp dosa. Find your nearest kitchen and order for pickup or delivery.";
    ViewData["Current"] = "home";
    // Ordering needs a city: these links open the Locations pop-up (href is the no-JS fallback).
    const string orderUrl = "/";

    const string butterChicken = "1603894584373-5ac82b2ae398"; // creamy curry

    string Img(string id, int w, int h) => $"https://images.unsplash.com/photo-{id}?auto=format&fit=crop&w={w}&h={h}&q=70";
    var menuItems = ((IEnumerable<Product>)ViewBag.MenuItems).ToList();
    var menuShowcase = ((IEnumerable<Product>)ViewBag.MenuShowcase)
        .GroupBy(product => product.Name)
        .ToDictionary(group => group.Key, group => group.First());
    var kitchenDishNames = new[] { "Grill Chicken", "Chilli Chicken" };
    var trendingDishNames = new[] { "Paneer Tikka", "Gobi Manchurian", "Vanilla Ice Cream", "Masala Lassi" };
}
<div>

        <!-- 1. Welcome hero -->
        <section class="pt-hero" data-hero-root aria-labelledby="ptHeroTitle">
            <div class="pt-hero__lattice" aria-hidden="true"></div>
            <div class="pt-wrap pt-hero__grid">
                <div class="pt-hero__copy">
                    <h1 id="ptHeroTitle" data-split>HT Restaurant. Where Indian cuisine <em>meets tradition.</em></h1>
                    <p class="pt-lede" data-hero>From slow-cooked biryani to crisp dosa and tandoor-fired favourites, HT Restaurant brings home-style Indian cooking to your table, ready for pickup or delivery.</p>
                    <div class="pt-actions" data-hero>
                        <a class="pt-btn pt-btn--solid" href="@orderUrl" data-locations-open aria-haspopup="dialog">Order online</a>
                        <button type="button" class="pt-btn pt-btn--line" data-locations-open aria-haspopup="dialog">Find a kitchen</button>
                    </div>
                </div>

                <ul class="pt-menu-gallery" aria-label="Photos of menu items">
                        @foreach (Product product in menuItems)
                        {
                            <li class="pt-menu-gallery__item">
                                <img src="@product.ImageUrl" alt="@product.Name" decoding="async" />
                            </li>
                        }
                </ul>
            </div>
        </section>

        <!-- 2. Tradition -->
        <section class="pt-section" aria-labelledby="ptTraditionTitle">
            <div class="pt-wrap">
                <div class="pt-band pt-band--ink" data-reveal>
                    <div class="pt-band__media pt-band__media--menu" aria-label="Grill Chicken and Chilli Chicken">
                        @foreach (var dishName in kitchenDishNames)
                        {
                            if (menuShowcase.TryGetValue(dishName, out var product))
                            {
                                <figure class="pt-band__menu-item">
                                    <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" decoding="async" />
                                </figure>
                            }
                        }
                    </div>
                    <div class="pt-band__body">
                        <p class="pt-kicker">Our kitchen</p>
                        <h2 id="ptTraditionTitle" data-split>A taste of tradition, plated for today.</h2>
                        <p data-reveal>Every dish starts the way it always has: whole spices, slow heat and recipes handed down, cooked fresh each day and sent to your table without shortcuts.</p>
                        <div class="pt-actions" data-reveal>
                            <a class="pt-btn pt-btn--gold" href="@orderUrl" data-locations-open aria-haspopup="dialog">Order now</a>
                            <a class="pt-btn pt-btn--ghost-light" href="/about">Learn more</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. Nearest kitchen -->
        <section class="pt-section" aria-labelledby="ptNearestTitle">
            <div class="pt-wrap">
                <div class="pt-band pt-band--gold pt-band--flip" data-reveal>
                    <div class="pt-band__body">
                        <p class="pt-kicker">Locations</p>
                        <h2 id="ptNearestTitle" data-split>Find your nearest HT kitchen.</h2>
                        <p data-reveal>Pick your city, browse the day's menu and order for pickup or delivery in a few taps.</p>
                        <div class="pt-actions" data-reveal>
                            <button type="button" class="pt-btn pt-btn--solid" data-locations-open aria-haspopup="dialog">View locations</button>
                        </div>
                    </div>
                    <div class="pt-band__media">
                        <img src="@Img(butterChicken, 900, 700)" srcset="@Img(butterChicken, 900, 700) 1x, @Img(butterChicken, 1600, 1244) 2x" width="900" height="700" alt="A creamy, spiced curry in a pan" loading="lazy" decoding="async" />
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. Trending -->
        <section class="pt-section pt-trending" aria-labelledby="ptTrendingTitle">
            <div class="pt-wrap">
                <div class="pt-trending__head">
                    <h2 id="ptTrendingTitle" data-split>Trending across our kitchens</h2>
                    <p data-reveal>Bold curries, tandoor-fired starters and street-food favourites, the plates our guests keep coming back for.</p>
                </div>
                <ul class="pt-gallery" role="list">
                    @foreach (var dishName in trendingDishNames)
                    {
                        if (menuShowcase.TryGetValue(dishName, out var product))
                        {
                            <li class="pt-gallery__item" data-gallery-item>
                                <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" decoding="async" />
                            </li>
                        }
                    }
                </ul>
            </div>
        </section>
    </div>
