@model DemoTicket
@{
    var client = (DemoClient)ViewBag.Client;
    ViewData["Title"] = $"#{Model.Number} {Model.Title}";
    string When(DateTime utc) => utc.ToLocalTime().ToString("d MMM yyyy, HH:mm");
}
<div class="container admin-pad" style="max-width:860px">
    <p style="font-size:0.875rem">
        <a asp-area="Platform" asp-controller="Clients" asp-action="Project" asp-route-id="@client.Id" asp-route-projectId="@Model.ProjectId" class="text-muted">&larr; @client.Name / @DemoWorkspaceStore.ProjectName(Model.ProjectId)</a>
    </p>

    <header class="page-heading" style="margin-top:12px">
        <h1>@Model.Title <span class="text-muted tabular">#@Model.Number</span></h1>
        @if (Model.Source.Length > 0)
        {
            <p class="text-muted" style="font-size:0.875rem;margin:8px 0 0">Raised from the restaurant @Model.Source.ToLowerInvariant()</p>
        }
        <span class="status-pill">
            <span class="dot @(Model.IsOpen ? "dot-done" : "stage-dot-review")"></span>
            @(Model.IsOpen ? "Open" : "Closed")
        </span>
    </header>

    @if (TempData["Error"] is string error)
    {
        <div class="alert-error" role="alert" style="margin-top:20px">@error</div>
    }

    <ol class="thread">
        @for (var i = 0; i < Model.Thread.Count; i++)
        {
            var entry = Model.Thread[i];
            if (entry.Event is not null)
            {
                <li class="event"><strong>@entry.Author</strong> @entry.Event &middot; @When(entry.PostedUtc)</li>
            }
            else if (i > 0 || entry.Body.Length > 0)
            {
                <li>
                    <div class="head"><strong>@entry.Author</strong> @(i == 0 ? "raised this ticket" : "commented") &middot; @When(entry.PostedUtc)</div>
                    <div class="body md" data-md>@entry.Body</div>
                </li>
            }
            else
            {
                <li class="event"><strong>@entry.Author</strong> raised this ticket &middot; @When(entry.PostedUtc)</li>
            }
        }
    </ol>

    <form method="post" asp-area="Platform" asp-controller="Clients" asp-action="Comment" asp-route-id="@client.Id" asp-route-number="@Model.Number" style="margin-top:8px">
        <h2 class="title" style="font-size:1rem;margin-bottom:12px">Add a comment</h2>
        <partial name="_Composer" model="@("body")" />
        <div class="composer-actions">
            @if (Model.IsOpen)
            {
                <button type="submit" name="action" value="close" class="btn btn-secondary">Close ticket</button>
            }
            else
            {
                <button type="submit" name="action" value="reopen" class="btn btn-secondary">Reopen ticket</button>
            }
            <button type="submit" name="action" value="comment" class="btn btn-primary">Comment</button>
        </div>
    </form>
</div>
