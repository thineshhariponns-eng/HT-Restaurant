@model EditClientViewModel
@{ ViewData["Title"] = $"Edit {Model.Name}"; }
<div class="container admin-pad" style="max-width:760px">
    <p style="font-size:0.875rem">
        <a asp-area="Platform" asp-controller="Clients" asp-action="Details" asp-route-id="@Model.Id" class="text-muted">&larr; Back to client</a>
    </p>

    <header class="page-heading" style="margin-top:12px">
        <h1>Edit client</h1>
        <p class="text-muted" style="font-size:0.875rem">Update this client's contact details and hostnames.</p>
    </header>

    <form method="post" asp-area="Platform" asp-controller="Clients" asp-action="Edit" asp-route-id="@Model.Id" novalidate>
        <input type="hidden" asp-for="Id" />
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="alert-error"></div>
        }

        <section class="form-card">
            <h2 class="title" style="font-size:1rem">Client information</h2>

            <div class="field" style="margin-top:20px">
                <label asp-for="Name">Client name</label>
                <input asp-for="Name" autocomplete="organization" />
                <span asp-validation-for="Name" class="field-error-text"></span>
            </div>

            <div class="field">
                <label asp-for="City">Branch or town <span class="text-muted">(optional)</span></label>
                <input asp-for="City" autocomplete="address-level2" />
            </div>

            <div class="field">
                <label asp-for="Contact">Contact name</label>
                <input asp-for="Contact" autocomplete="name" />
                <span asp-validation-for="Contact" class="field-error-text"></span>
            </div>

            <div class="field">
                <label asp-for="ContactEmail">Contact email</label>
                <input asp-for="ContactEmail" type="email" autocomplete="email" />
                <span asp-validation-for="ContactEmail" class="field-error-text"></span>
            </div>
        </section>

        <section class="form-card" style="margin-top:20px">
            <h2 class="title" style="font-size:1rem">Domain configuration</h2>

            <div class="field" style="margin-top:20px">
                <label asp-for="Domain">Customer hostname</label>
                <input asp-for="Domain" />
                <span asp-validation-for="Domain" class="field-error-text"></span>
            </div>

            <div class="field">
                <label asp-for="AdminDomain">Admin hostname</label>
                <input asp-for="AdminDomain" />
                <span asp-validation-for="AdminDomain" class="field-error-text"></span>
            </div>

            <div class="actions-row" style="margin-bottom:0;justify-content:space-between">
                <a class="btn btn-secondary" asp-area="Platform" asp-controller="Clients" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </section>
    </form>
</div>
