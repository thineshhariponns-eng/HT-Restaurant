@{
    ViewData["Title"] = "Domains";
    var clients = DemoClientStore.All();
}
<div class="container admin-pad">
    <header class="page-heading">
        <h1>Domains</h1>
        <p class="text-muted" style="font-size:0.875rem">@(clients.Count * 2) hosts across @clients.Count clients</p>
    </header>

    <table class="ruled">
        <thead><tr><th>Domain</th><th>Client</th><th>Type</th></tr></thead>
        <tbody>
        @foreach (var client in clients)
        {
            <tr>
                <td class="text-primary">@client.Domain</td>
                <td class="text-body">@client.Name</td>
                <td><span style="display:inline-flex;align-items:center;gap:8px" class="text-body"><span class="dot dot-done"></span>Customer</span></td>
            </tr>
            <tr>
                <td class="text-primary">@client.ResolvedAdminDomain</td>
                <td class="text-body">@client.Name</td>
                <td><span style="display:inline-flex;align-items:center;gap:8px" class="text-body"><span class="dot dot-delivery"></span>Admin</span></td>
            </tr>
        }
        </tbody>
    </table>

    <p class="text-muted" style="font-size:0.8125rem;margin-top:16px">
        Local demo hosts. Point each one at 127.0.0.1 in your hosts file to browse it.
    </p>
</div>
