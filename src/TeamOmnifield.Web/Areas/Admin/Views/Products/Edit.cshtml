@model ProductEditViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Add Product" : "Edit Product";
    var categories = (IEnumerable<Category>)(ViewBag.Categories ?? Enumerable.Empty<Category>());
}
<header class="page-heading"><h1>@ViewData["Title"]</h1></header>
<div class="admin-pad">
    <div class="form-card">
        <div asp-validation-summary="ModelOnly" class="alert-error"></div>
        <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
            <input asp-for="Id" type="hidden" />
            <div class="field">
                <label asp-for="Name"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="field-error-text"></span>
            </div>
            <div class="field">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" rows="3"></textarea>
                <span asp-validation-for="Description" class="field-error-text"></span>
            </div>
            <div class="field">
                <label asp-for="Price"></label>
                <input asp-for="Price" step="0.01" />
                <span asp-validation-for="Price" class="field-error-text"></span>
            </div>
            <div class="field">
                <label asp-for="ImageUrl">Image URL</label>
                <input asp-for="ImageUrl" placeholder="https://..." oninput="document.getElementById('imgPreview').src=this.value" />
                <span asp-validation-for="ImageUrl" class="field-error-text"></span>
                <img id="imgPreview" src="@Model.ImageUrl" alt="" class="product-thumb" style="margin-top:8px" onerror="this.style.visibility='hidden'" onload="this.style.visibility='visible'" />
            </div>
            <div class="field">
                <label asp-for="CategoryId">Category</label>
                <select asp-for="CategoryId">
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="checkbox-row"><input asp-for="IsAvailable" /> Available for ordering</label>
            </div>
            <button class="btn btn-primary" type="submit">Save</button>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
