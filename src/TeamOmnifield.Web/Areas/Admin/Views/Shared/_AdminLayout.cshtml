@inject TeamOmnifield.Web.Services.OrderService AdminOrderService
@inject TeamOmnifield.Web.Services.CityContextService CityContext
@{
    var currentController = (string)ViewContext.RouteData.Values["controller"]!;
    bool IsActive(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
    var city = CityContext.Current;
    // Pending badge counts only the selected location's orders.
    var pendingCount = (await AdminOrderService.GetAdminListAsync(TeamOmnifield.Web.Models.OrderStatus.Pending, null, city.Slug)).Count;
    var supportSiteSlug = TeamOmnifield.Web.Services.DemoWorkspaceStore.Cities.Contains(city.Slug) ? city.Slug : "chennai";
    var supportSite = TeamOmnifield.Web.Services.DemoWorkspaceStore.ProjectByName(TeamOmnifield.Web.Services.DemoWorkspaceStore.AdminPortalProject(supportSiteSlug));
    var openTickets = supportSite is null ? 0 : TeamOmnifield.Web.Services.DemoWorkspaceStore.TicketsOf(supportSite.ClientId, supportSite.Id).Count(t => t.IsOpen);
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] &middot; HT Restaurant @city.Name Admin</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin">
<div class="admin-shell">
    <aside class="admin-sidebar" aria-label="Sidebar">
        <div class="admin-sidebar-inner">
            <a href="/Admin" class="admin-brand">
                <span class="name">HT Restaurant</span>
                <span class="place label-caps">@city.Name &middot; Admin</span>
            </a>
            <nav class="admin-nav" aria-label="Admin">
                <p class="label-caps group-label">Operations</p>
                <a href="/Admin" class="admin-nav-link @(IsActive("Dashboard") ? "active" : "")">Dashboard</a>
                <a href="/Admin/Orders" class="admin-nav-link @(IsActive("Orders") ? "active" : "")">
                    Orders
                    @if (pendingCount > 0)
                    {
                        <span class="count">@pendingCount</span>
                    }
                </a>
                <p class="label-caps group-label">Catalog</p>
                <a href="/Admin/Products" class="admin-nav-link @(IsActive("Products") ? "active" : "")">Products</a>
                <p class="label-caps group-label">Support</p>
                <a href="/Admin/Tickets" class="admin-nav-link @(IsActive("Tickets") ? "active" : "")">
                    Raise a ticket
                    @if (openTickets > 0)
                    {
                        <span class="count">@openTickets</span>
                    }
                </a>
            </nav>
            <div class="admin-footnote">
                <p style="margin:0 0 10px">Signed in as @(User.Identity!.Name ?? "admin"). Changes are saved live to the database.</p>
                <p class="text-muted tabular" style="margin:0 0 10px;font-size:0.75rem">Omnifield @TeamOmnifield.Web.Services.AppVersionInfo.Display</p>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-secondary btn-sm btn-block">Logout</button>
                </form>
            </div>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <button type="button" class="admin-drawer-toggle" data-drawer-open="#adminMobileSidebar" aria-label="Open navigation">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>
            <nav aria-label="Breadcrumb" class="admin-breadcrumb">
                <span class="text-muted">Admin</span><span class="sep">/</span>@ViewData["Title"]
            </nav>
            <details class="loc-switch" data-loc-switch>
                <summary aria-label="Change location, currently @city.Name">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
                    <span>@city.Name</span>
                    <svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                </summary>
                <form asp-area="Admin" asp-controller="Location" asp-action="Set" method="post" class="loc-menu">
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <p class="loc-title">Working location</p>
                    @foreach (var c in TeamOmnifield.Web.Services.CityContextService.Cities.Values)
                    {
                        <button type="submit" name="slug" value="@c.Slug" class="@(c.Slug == city.Slug ? "current" : "")">@c.Name</button>
                    }
                </form>
            </details>
            <a href="http://localhost:8091/" class="btn btn-ghost btn-sm">Home</a>
            <p class="admin-clock"><time class="time tabular" data-admin-clock></time></p>
        </header>
        <main id="main" class="admin-content">
            @if (TempData["Error"] is string error)
            {
                <div class="container admin-pad" style="padding-bottom:0"><div class="alert-error">@error</div></div>
            }
            @RenderBody()
        </main>
    </div>
</div>

<div id="adminMobileSidebar" class="admin-mobile-sidebar">
    <div class="scrim" data-drawer-close></div>
    <div class="panel">
        <a href="/Admin" class="admin-brand">
            <span class="name">HT Restaurant</span>
            <span class="place label-caps">@city.Name &middot; Admin</span>
        </a>
        <nav class="admin-nav" aria-label="Admin mobile">
            <p class="label-caps group-label">Operations</p>
            <a href="/Admin" class="admin-nav-link @(IsActive("Dashboard") ? "active" : "")">Dashboard</a>
            <a href="/Admin/Orders" class="admin-nav-link @(IsActive("Orders") ? "active" : "")">Orders</a>
            <p class="label-caps group-label">Catalog</p>
            <a href="/Admin/Products" class="admin-nav-link @(IsActive("Products") ? "active" : "")">Products</a>
            <p class="label-caps group-label">Support</p>
            <a href="/Admin/Tickets" class="admin-nav-link @(IsActive("Tickets") ? "active" : "")">Raise a ticket</a>
        </nav>
        <div class="admin-footnote">
            <p class="text-muted tabular" style="margin:0 0 10px;font-size:0.75rem">Omnifield @TeamOmnifield.Web.Services.AppVersionInfo.Display</p>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-secondary btn-sm btn-block">Logout</button>
            </form>
        </div>
    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/admin.js" asp-append-version="true"></script>
<script src="~/js/platform.js" asp-append-version="true"></script>
</body>
</html>
